# Server-only (never prefix with VITE_): used by api/gemini.ts and the Vite dev proxy
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model (default is set in api/gemini.ts)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: browser origins allowed to call the API cross-origin (comma-separated)
# ALLOWED_ORIGINS=https://xdobriev.github.io

# Client-side: base URL of the deployment that hosts /api/gemini (empty = same origin)
# VITE_API_BASE=https://your-project.vercel.app

# Optional: WebSocket relay (npm run relay) so the classroom syncs across devices, not just tabs
# VITE_SYNC_URL=ws://localhost:8787
